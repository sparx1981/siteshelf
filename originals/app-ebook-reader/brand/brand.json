    "voice": {
      "summary": "Reads like a quiet marginal note in a well-loved book: low-voiced, a little mysterious and never in a hurry. The interface keeps out of the way so the story keeps the spotlight.",
      "dos": [
        "Write controls as short, unshowy labels the reader barely notices",
        "Borrow the novella's lantern and sea imagery sparingly",
        "Confirm actions in a single calm line"
      ],
      "donts": [
        "Gamified streaks or reading targets",
        "Loud exclamations that break the spell",
        "Technical jargon about rendering or storage"
      ]
    },
    "taglines": [
      "The sea keeps a second map",
      "Read on, the lamp is lit",
      "One more page by lantern light",
      "A story kept at Kestrel Point",
      "Turn the page, mind the tide"
    ],
