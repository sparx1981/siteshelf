    "voice": {
      "summary": "Talks like a cheerful friend pushing the trolley next to you: short, practical, a bit chatty about food. It keeps the list moving and never nags about what is left.",
      "dos": [
        "Name aisles the way shoppers do: produce, bakery, dairy",
        "Count progress in plain numbers such as 5 of 14",
        "Keep every line short enough to read one-handed"
      ],
      "donts": [
        "No diet or health lectures",
        "No exclamation overload on routine ticks",
        "No store-brand jargon like SKU or planogram"
      ]
    },
    "taglines": [
      "Shop in the order you walk",
      "Fewer laps, fuller basket",
      "Tick it off, trolley on",
      "One pass round the shop",
      "Your list knows the layout"
