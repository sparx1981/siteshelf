    "voice": {
      "summary": "Stillwater speaks softly and slowly, like a teacher who is happy to let a silence stand. Sentences are short, verbs are kind, and nothing ever asks for urgency.",
      "dos": [
        "Use short sentences with room to breathe",
        "Invite rather than instruct: 'when you are ready'",
        "Prefer concrete images such as lake, breath and bell"
      ],
      "donts": [
        "Do not use streaks, scores or pressure",
        "Do not use exclamation marks",
        "Do not promise enlightenment or cures"
      ]
    },
    "taglines": [
      "Breathe for a few minutes",
      "Let the water settle",
      "One slow breath at a time",
      "Stillness, kept in your pocket",
      "Come back to the lake"
    ],
