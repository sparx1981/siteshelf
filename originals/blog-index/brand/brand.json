    "voice": {
      "summary": "Writes like a good colleague explaining what worked, with numbers rather than hype. Headlines make one clear claim and the excerpt gives the evidence.",
      "dos": [
        "Lead with the result, then the method",
        "Use one number per excerpt where possible",
        "Keep titles under ten words"
      ],
      "donts": [
        "No clickbait questions",
        "No jargon stacked on jargon",
        "No claims without the measured outcome"
      ]
    },
    "taglines": [
      "Notes from the work itself",
      "Small lessons, written down",
      "What we tried and what held",
      "Fewer clever ideas, more finished ones",
      "Plain notes on building well"
    ],
