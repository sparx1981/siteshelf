    "voice": {
      "summary": "Slow Signal writes the way its host talks: patient, observant and a little wry. Show notes read like a good caption in a field notebook, precise about who said what and when.",
      "dos": [
        "Give timestamps and speaker names for every claim",
        "Open with the question the guest answers, not the guest's CV",
        "Keep descriptions to a calm paragraph"
      ],
      "donts": [
        "No clickbait titles or 'you will not believe'",
        "Do not summarise a quote that can simply be quoted",
        "Avoid 'epic', 'amazing' and other podcast filler"
      ]
    },
    "taglines": [
      "Listen slowly",
      "Conversations worth the long way round",
      "Episodes for the unhurried",
      "Maps, makers and quiet minds",
      "Turn it down and lean in"
