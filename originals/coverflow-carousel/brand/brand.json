    "voice": {
      "summary": "Longway Tapes sounds like a handwritten note slipped inside a cassette case: intimate, a bit sentimental and specific about when and where to listen. Titles do most of the work.",
      "dos": [
        "Name each mix after a place, time or weather",
        "Say where and when to press play",
        "Keep the tone personal, like a gift"
      ],
      "donts": [
        "Use streaming-service language like 'curated for you'",
        "Over-explain the music",
        "Use exclamation marks"
      ]
    },
