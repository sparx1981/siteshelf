      "direct",
      "encouraging"
    ],
    "voice": {
      "summary": "Sounds like a coach counting you through the last rep: short commands, specific numbers and a nod when you finish. Hype is kept for the finish line, not the warm-up.",
      "dos": [
        "Use short imperatives like Rest, Lift, Log",
        "Show sets, reps and kilos exactly",
        "Give credit when a streak holds"
      ],
      "donts": [
        "Do not shame missed days",
        "Do not use diet-culture language",
        "Do not use vague motivation like crush it"
      ]
    },
    "taglines": [
      "Show up. Lift. Log it.",
