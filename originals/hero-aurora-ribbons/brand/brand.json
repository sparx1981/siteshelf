    "voice": {
      "summary": "Vesper writes like a field journal read by torchlight: precise about weather and sky, restrained in feeling and wide-eyed at the right moment. Sentences are long enough to breathe.",
      "dos": [
        "Anchor sentences in a place, a season or a light condition",
        "Use understated verbs of watching and waiting",
        "Prefer one precise image to three adjectives"
      ],
      "donts": [
        "Use travel-brochure superlatives",
        "Use exclamation marks",
        "Explain the wonder"
      ]
    },
