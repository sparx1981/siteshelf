    "voice": {
      "summary": "Hearthstone Home sounds like a shop assistant who loves a nice mug and will tell you honestly if the shelf is too small. Product copy is plain, specific about size and colour, and never over-sold.",
      "dos": [
        "Give size, colour and material in the first line",
        "Write like a shop-floor recommendation",
        "Use warm, practical verbs: fill, hold, brighten"
      ],
      "donts": [
        "Do not use 'must-have' or 'obsessed'",
        "Avoid fake urgency",
        "Never hide delivery costs"
      ]
    },
