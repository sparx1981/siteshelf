    "voice": {
      "summary": "Talks like a founder who answers support emails personally: direct, specific and a bit dry. Answers start with yes or no, and the reasoning follows in a sentence or two.",
      "dos": [
        "Start answers with yes or no",
        "Give a number or a date where possible",
        "Keep each answer under forty words"
      ],
      "donts": [
        "No evasive hedging",
        "Avoid legal jargon in answers",
        "Never say it depends without saying on what"
      ]
    },
