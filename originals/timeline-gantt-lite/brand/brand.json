    "voice": {
      "summary": "Trellis sounds like a site foreman with a whiteboard: clear, grounded and unflappable. It names tasks, dates and dependencies plainly and highlights the critical path without drama.",
      "dos": [
        "Name tasks as verbs plus objects",
        "Show dates as day and month",
        "Call out the critical path in one phrase"
      ],
      "donts": [
        "Do not use agile jargon",
        "Avoid colours as the only signal",
        "Never move dates without saying why"
      ]
    },
