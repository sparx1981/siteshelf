    "voice": {
      "summary": "Harrow Observatory writes like an amateur astronomer sharing a hard-won story over tea. It is warm, factual about dates and instruments, and quietly awed rather than grand.",
      "dos": [
        "Give the year and the instrument for each event",
        "Use plain observing language: night, dome, plate",
        "Credit the volunteers by name"
      ],
