    "voice": {
      "summary": "Sounds like a designer's bench notes: terse labels, helpful warnings and zero fluff. It explains contrast ratios and stops in numbers, and leaves taste to the user.",
      "dos": [
        "Name controls by function, such as stops, angle and type",
        "Give contrast ratios as numbers",
        "Provide copyable code, never screenshots"
      ],
      "donts": [
        "Do not describe gradients with poetic filler",
        "Do not hide the CSS output",
        "Do not say perfect"
      ]
    },
    "taglines": [
