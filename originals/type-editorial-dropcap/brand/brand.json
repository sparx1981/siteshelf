    "voice": {
      "summary": "Saltgate Courier sounds like a seaside paper with ambitions: craftsmanlike, full of local detail and gently wry. Sentences run long enough for a proper drop cap.",
      "dos": [
        "Open with a concrete scene or object",
        "Use sidenotes for asides, not for padding",
        "Prefer old words for light and weather"
      ],
      "donts": [
        "Use clickbait headlines",
        "Use jargon from tech or marketing",
        "Rush the reader"
      ]
    },
