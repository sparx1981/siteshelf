    "voice": {
      "summary": "Tickdown sounds like a stopwatch with a friendly face: crisp, numerical and glad when the big day arrives. Units and times lead, and feelings follow.",
      "dos": [
        "Put days, hours, minutes and seconds in that order",
        "Name the event and its date plainly",
        "Mark passed events calmly as 'ended'"
      ],
