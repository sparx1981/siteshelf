    "voice": {
      "summary": "Trav sounds like a well-travelled friend with a map in the back pocket. It is warm, direct and excited about hidden places without exaggeration.",
      "dos": [
        "Name a place or a mood",
        "Use verbs of movement: find, plan, go",
        "Keep every line short"
      ],
